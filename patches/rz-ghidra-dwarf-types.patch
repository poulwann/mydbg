+Datatype *RizinTypeFactory::addRizinUnion(RzBaseType *type, StackTypes &stack_types, bool prototype)
+{
+	assert(type->kind == RZ_BASE_TYPE_KIND_UNION);
+	TypeUnion *result = getTypeUnion(type->name);
+	if (prototype)
+	{
+		prototypes.insert(result);
+		return result;
+	}
+	prototypes.erase(result);
+	try
+	{
+		std::vector<TypeField> fields;
+		rz_vector_foreach_cpp<RzTypeUnionMember>(&type->union_data.members, [&](RzTypeUnionMember *member) {
+			if (!member->type || !member->name)
+				return;
+			Datatype *memberType = fromRzType(member->type, nullptr, &stack_types);
+			if (!memberType)
+				throw LowlevelError("Union member type is not representable");
+			fields.emplace_back(static_cast<int4>(fields.size()), 0, member->name, memberType);
+		});
+		if (type->size / 8 > static_cast<ut64>(std::numeric_limits<int4>::max()))
+			throw LowlevelError("Union size is not representable");
+		setFields(fields, result, static_cast<int4>(type->size / 8), 0);
+		return result;
+	}
+	catch (LowlevelError &error)
+	{
+		arch->addWarning(std::string("Failed to load union ") + type->name + ": " + error.explain);
 		return nullptr;
 	}
 }
