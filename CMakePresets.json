{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "RelWithDebInfo build with tests enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "native-dev",
      "displayName": "Native development",
      "description": "Development tests without QEMU, cross compilers, or symbolic solvers",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/native-dev",
      "cacheVariables": {
        "MYDBG_CROSS_ARCH_TESTS": "OFF",
        "MYDBG_SYMBOLIC_TESTS": "OFF"
      }
    },
    {
      "name": "system-dev",
      "displayName": "Development with system analysis dependencies",
      "description": "RelWithDebInfo build using system Rizin and rz-ghidra",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/system-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "MYDBG_DEPS_PREFIX": ""
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized application build without tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "native-dev",
      "configurePreset": "native-dev"
    },
    {
      "name": "system-dev",
      "configurePreset": "system-dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "native-dev",
      "configurePreset": "native-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "system-dev",
      "configurePreset": "system-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
